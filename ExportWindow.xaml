<Window x:Class="VideoPlayer.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export clip" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#202020" Closing="Window_Closing" FontFamily="{StaticResource UiFont}">
    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,20,24,20">
        <TextBlock Text="Export clip" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
        <TextBlock x:Name="ClipInfo" Foreground="#AAAAAA" FontSize="13" Margin="0,4,0,18" TextWrapping="Wrap"/>

        <Grid x:Name="Options">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Format" Style="{StaticResource Label}"/>
            <ComboBox x:Name="FormatBox" Grid.Row="0" Grid.Column="1" SelectionChanged="FormatBox_SelectionChanged"/>

            <TextBlock Grid.Row="1" Text="Resolution" Style="{StaticResource Label}"/>
            <ComboBox x:Name="ResolutionBox" Grid.Row="1" Grid.Column="1"/>

            <TextBlock Grid.Row="2" Text="Quality" Style="{StaticResource Label}"/>
            <ComboBox x:Name="QualityBox" Grid.Row="2" Grid.Column="1"/>

            <TextBlock Grid.Row="3" Text="Frame rate" Style="{StaticResource Label}"/>
            <ComboBox x:Name="FpsBox" Grid.Row="3" Grid.Column="1"/>

            <TextBlock Grid.Row="4" Text="Encoder" Style="{StaticResource Label}"/>
            <ComboBox x:Name="EncoderBox" Grid.Row="4" Grid.Column="1" SelectionChanged="EncoderBox_SelectionChanged"/>
        </Grid>

        <CheckBox x:Name="CopyBox" Margin="0,4,0,0" Checked="CopyBox_Changed" Unchecked="CopyBox_Changed">
            <TextBlock Foreground="#DDDDDD" FontSize="12" TextWrapping="Wrap"
                       Text="Fast copy: no re-encoding, so it's near-instant with no quality loss, but the cut snaps to the nearest keyframe and the settings above are ignored."/>
        </CheckBox>

        <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,18,0,0">
            <ProgressBar x:Name="Progress" Height="6" Maximum="100" Foreground="#FFD400"
                         Background="#33FFFFFF" BorderThickness="0"/>
            <TextBlock x:Name="StatusText" Foreground="#AAAAAA" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="ExportBtn" Style="{StaticResource AccentButton}" Content="Export…" MinWidth="110" Click="Export_Click"/>
            <Button x:Name="CancelBtn" Style="{StaticResource TextButton}" Content="Cancel" MinWidth="90" Margin="8,0,0,0" Click="Cancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
